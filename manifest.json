{
  "manifest_version": 2,
  "name": "Opp Elimination",
  "version": "0.2.0",
  "description": "Personal tool to track Instagram unfollowers.",
  "browser_specific_settings": {
    "gecko": {
      "id": "f55.lotf@gmail.com"
    }
  },
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Opp Elimination"
  }
}